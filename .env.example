# Copia a .env y rellena. .env está en .gitignore.
ANTHROPIC_API_KEY=
ACCESS_TOKEN=cambia-esto-por-algo-largo-y-secreto
OWNER_NAME=Jose
TZ=America/Mexico_City
# Modelo (por defecto claude-opus-5-5) y esfuerzo de razonamiento (low = más rápido)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# Piper: ruta al binario y a la voz .onnx (el .onnx.json debe estar al lado)
# PIPER_BIN=piper
PIPER_MODEL=voices/es_MX-claude-high.onnx
